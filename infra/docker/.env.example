# Copy to infra/docker/.env before running `docker compose up`.
# Reference: https://github.com/frappe/frappe_docker/blob/main/docs/02-setup/04-env-variables.md

ERPNEXT_VERSION=v16.30.0

# ERPNext site
SITE_NAME=hermes.localhost
ADMIN_PASSWORD=change-me-admin-password
DB_ROOT_PASSWORD=change-me-db-root-password

# Port the ERPNext frontend (nginx) is published on, on the Docker host.
HTTP_PUBLISH_PORT=8080

# Port the Hermes app-layer Redis (BullMQ) is published on, on the Docker
# host — must match REDIS_URL in the repo-root .env.
HERMES_REDIS_PUBLISH_PORT=6380

# --- Phase 9: apps/dashboard and apps/pwa-scanner (added when containerized) ---
# Baked into their static builds at image-build time (Vite inlines
# import.meta.env — there is no runtime env var to change after the image
# exists). Every API call in both apps' src/lib/api.ts already includes
# the full "/api/v1/..." path in the fetch call itself (e.g.
# fetch(`${API_BASE_URL}/api/v1/auth/login`)) — so this must stay EMPTY
# for same-origin deployment (Nginx routes /api/ to the api container).
# Setting this to "/api" (an earlier default here, wrong) produces a
# doubled "/api/api/v1/..." URL that 401s — a real bug found live during
# the domain/HTTPS verification pass, invisible until then because
# nothing had tested a real browser login through the actual Nginx proxy
# path before (only direct curl to the container's own port). Only set
# this to a non-empty value if the API is genuinely served from a
# different origin/path than the dashboard/scanner.
DASHBOARD_API_BASE_URL=
PWA_SCANNER_API_BASE_URL=
