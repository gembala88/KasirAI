{
  "name": "@hermes/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hermes application layer — Fastify + TypeScript modular monolith on top of ERPNext.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:erpnext": "tsx scripts/seed-erpnext.ts",
    "load-test": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.2",
    "@sentry/node": "^10.69.0",
    "bullmq": "^5.34.10",
    "close-with-grace": "^2.2.0",
    "cockatiel": "^3.2.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.7",
    "autocannon": "^8.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
