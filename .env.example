# Copy to .env and adjust for local development. Loaded by apps/api via
# apps/api/src/config/env.ts (zod-validated — invalid/missing required
# values fail fast on boot).
#
# For the ERPNext Docker stack's own bootstrap variables (site name, admin
# password, DB root password), see infra/docker/.env.example instead.

NODE_ENV=development
LOG_LEVEL=info
PORT=3000
HOST=0.0.0.0
# "*" reflects any origin — fine for local dev (apps/pwa-scanner,
# apps/dashboard on different ports). Set to a comma-separated allowlist
# of real origins before deploying.
CORS_ALLOWED_ORIGINS=*

# --- Auth ---
JWT_SECRET=change-me-to-a-random-32-character-minimum-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- ERPNext (source of truth) ---
# Points at the `frontend` container from infra/docker/docker-compose.yml.
# Generate ERPNEXT_API_KEY/ERPNEXT_API_SECRET with:
#   docker compose exec backend bench --site <site> execute \
#     frappe.core.doctype.user.user.generate_keys --args "['Administrator']"
# (see README.md "Setting up the Phase 1 data model")
ERPNEXT_BASE_URL=http://localhost:8080
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# Placeholder company/warehouse — see README "Renaming the placeholder
# company" before going to production.
ERPNEXT_DEFAULT_COMPANY=Toko Hermes
ERPNEXT_DEFAULT_WAREHOUSE=Gudang Utama - TH
ERPNEXT_WEBHOOK_SECRET=
ERPNEXT_WEBHOOK_CALLBACK_URL=http://host.docker.internal:3000/webhooks/erpnext

# --- Redis / BullMQ ---
# Points at the `hermes-redis` service in infra/docker/docker-compose.yml
# (published on 6380, separate from ERPNext's internal Redis instances).
REDIS_URL=redis://localhost:6380
PIUTANG_REMINDER_DAYS_AHEAD=3
PIUTANG_REMINDER_CRON=0 8 * * *

# --- AI Gateway: multi-provider, multi-key rotation (spec §3.1) ---
AI_PROVIDER_PRIORITY=mimo,gemini,nvidia,openai,claude
MIMO_API_KEYS=
GEMINI_API_KEYS=
NVIDIA_NIM_API_KEYS=
OPENAI_API_KEYS=
CLAUDE_API_KEYS=

# --- WhatsApp Business Cloud API ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Payment (§10 Phase 6: COD/Transfer alongside QRIS, all manually confirmed) ---
QRIS_STATIC_IMAGE_URL=
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ACCOUNT_NAME=

# --- Observability ---
SENTRY_DSN=
