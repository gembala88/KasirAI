# Copy to infra/docker/.env before running `docker compose up`.
# Reference: https://github.com/frappe/frappe_docker/blob/main/docs/02-setup/04-env-variables.md

ERPNEXT_VERSION=v16.30.0

# ERPNext site
SITE_NAME=hermes.localhost
ADMIN_PASSWORD=change-me-admin-password
DB_ROOT_PASSWORD=change-me-db-root-password

# Port the ERPNext frontend (nginx) is published on, on the Docker host.
HTTP_PUBLISH_PORT=8080

# Port the Hermes app-layer Redis (BullMQ) is published on, on the Docker
# host — must match REDIS_URL in the repo-root .env.
HERMES_REDIS_PUBLISH_PORT=6380
