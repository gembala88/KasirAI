# Copy to .env and adjust for local development. Loaded by apps/api via
# apps/api/src/config/env.ts (zod-validated — invalid/missing required
# values fail fast on boot).
#
# For the ERPNext Docker stack's own bootstrap variables (site name, admin
# password, DB root password), see infra/docker/.env.example instead.

NODE_ENV=development
LOG_LEVEL=info
PORT=3000
HOST=0.0.0.0

# --- Auth ---
JWT_SECRET=change-me-to-a-random-32-character-minimum-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- ERPNext (source of truth) ---
# Point this at the `frontend` container from infra/docker/docker-compose.yml
# (defaults to http://localhost:8080) once Phase 1 wires up the API client.
ERPNEXT_BASE_URL=http://localhost:8080
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- AI Gateway: multi-provider, multi-key rotation (spec §3.1) ---
AI_PROVIDER_PRIORITY=mimo,gemini,nvidia,openai,claude
MIMO_API_KEYS=
GEMINI_API_KEYS=
NVIDIA_NIM_API_KEYS=
OPENAI_API_KEYS=
CLAUDE_API_KEYS=

# --- WhatsApp Business Cloud API ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Payment (QRIS static image, manual confirmation for MVP — spec §7) ---
QRIS_STATIC_IMAGE_URL=

# --- Observability ---
SENTRY_DSN=
