# Further-trimmed MariaDB tuning for the SPECIFIC shared VPS this
# deployment was smoke-tested against — see
# infra/docker/docker-compose.shared-vps-test.yml for why. Not the
# general-purpose config; hermes-tuning.cnf remains correct for a
# dedicated VPS matching spec §13.
[mysqld]
innodb_buffer_pool_size = 64M
innodb_buffer_pool_instances = 1
innodb_log_file_size = 32M
max_connections = 30
thread_cache_size = 4
tmp_table_size = 8M
max_heap_table_size = 8M
performance_schema = OFF

# Same power-loss guarantee as the dedicated-VPS config (spec §15.1) —
# not something to relax just because this box is shared.
innodb_flush_log_at_trx_commit = 1
