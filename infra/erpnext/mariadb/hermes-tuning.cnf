# MariaDB tuning for the 2 vCPU / 2 GB RAM VPS target (spec §13).
# Mounted read-only into the `db` container at /etc/mysql/conf.d/ (see
# infra/docker/docker-compose.yml). Keeps InnoDB's buffer pool and per-
# connection buffers small enough that MariaDB stays inside its 512m
# `mem_limit` even under load.
[mysqld]
innodb_buffer_pool_size = 128M
innodb_buffer_pool_instances = 1
innodb_log_file_size = 64M
max_connections = 50
thread_cache_size = 8
tmp_table_size = 16M
max_heap_table_size = 16M
performance_schema = OFF

# Power-loss corruption protection (spec §15.1) — flush and fsync the
# InnoDB log on every transaction commit, guaranteeing a committed
# transaction survives a power loss. This happens to already be
# InnoDB's built-in default, but left implicit it's exactly the kind of
# thing that silently breaks if a future base-image/version change
# quietly ships a different default — explicit here so it can't drift.
innodb_flush_log_at_trx_commit = 1
